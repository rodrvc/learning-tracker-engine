__pycache__/
*.pyc
.venv/
.pytest_cache/
data/*.json
*.egg-info/
build/
dist/

# Agent tooling. It holds local settings and checks out whole worktrees in
# here, so a repository would end up nested inside the repository.
.claude/

# Environment files. They hold credentials and never belong in a public repo.
.env
.env.*
*.env
.envrc
!.env.example
