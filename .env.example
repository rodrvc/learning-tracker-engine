# The environment variables this project reads. They are read from the process
# environment: nothing here loads a .env file yet, so exporting them in your
# shell is what actually works today. Keeping them in a .env and sourcing it is
# a convention, and .env is gitignored precisely so that habit is safe.

# Where the JSON backend keeps its data. Defaults to the OS data directory
# when unset, so this is only needed to override it.
LEARNING_TRACKER_DATA=

# Where the database lives. Required by the web application, which refuses to
# start without it rather than defaulting to somewhere that happens to work.
LEARNING_TRACKER_DATABASE_URL=

# Schema inside that database. Optional; the backend uses its own default.
LEARNING_TRACKER_SCHEMA=

# Where the web application listens. Both optional.
LEARNING_TRACKER_WEB_HOST=
LEARNING_TRACKER_WEB_PORT=

# Read by the OpenAI client itself, and needed only to generate questions.
# Without it every other route keeps working: uploading, reading, practising
# and progress. In a deployment this belongs in the service's own variables,
# never in a file in the repository.
OPENAI_API_KEY=
