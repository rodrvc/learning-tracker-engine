# The environment variables this project reads. `scripts/dev-up.sh` sources a
# `.env` in the repo root when one exists (`cp .env.example .env` and edit);
# nothing else loads it, so exporting these in your shell also works.

# Where the JSON backend keeps its data. Defaults to the OS data directory
# when unset, so this is only needed to override it. The web application
# (below) does not use this at all - it always talks to Postgres.
LEARNING_TRACKER_DATA=

# Where the database lives. Required by the web application, which refuses to
# start without it rather than defaulting to somewhere that happens to work.
# This is the local development database `docker compose up` brings up
# (see docker-compose.yml) - the credentials below are that fixed local
# default, not a secret.
LEARNING_TRACKER_DATABASE_URL=postgresql://learning_tracker:learning_tracker@localhost:5432/learning_tracker

# Host port docker-compose publishes Postgres on. Optional, defaults to 5432.
# Change it if that port is already taken on your machine, and update
# LEARNING_TRACKER_DATABASE_URL above to match.
POSTGRES_PORT=

# Schema inside that database. Optional; the backend uses its own default
# ("learning").
LEARNING_TRACKER_SCHEMA=

# Where the web application listens. Both optional, default to 127.0.0.1:8000.
LEARNING_TRACKER_WEB_HOST=
LEARNING_TRACKER_WEB_PORT=

# Clerk issuer (frontend API URL) for this instance, e.g.
# https://example-app.clerk.accounts.dev. Unset (the default) switches
# authentication off entirely: every request is accepted, which is how the
# quickstart and the test suite run. Set both this and the key below to
# require a signed-in Clerk session on every route except /health and
# /auth/config.
LEARNING_TRACKER_CLERK_ISSUER=

# Clerk publishable key, served to the browser so it can start a session.
# Not a secret - Clerk documents it as safe to ship to a client - but it is
# specific to one Clerk instance, so it stays out of the repository like
# everything else here. Only meaningful together with the issuer above.
LEARNING_TRACKER_CLERK_PUBLISHABLE_KEY=

# Read by the OpenAI client itself, and needed only to generate questions.
# Without it every other route keeps working: uploading, reading, practising
# and progress. In a deployment this belongs in the service's own variables,
# never in a file in the repository.
OPENAI_API_KEY=
